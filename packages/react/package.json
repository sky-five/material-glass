  "scripts": {
    "build": "node build.mjs",
    "test": "node test.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "peerDependencies": {
    "material-glass": "^0.2.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "material-glass": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
