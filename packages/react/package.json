{
  "name": "@material-glass/react",
  "version": "0.2.0",
  "description": "Typed React components for Material Glass: Material 3 on Liquid-Glass surfaces.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
