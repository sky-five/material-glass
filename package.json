{
  "name": "material-glass",
  "version": "0.2.0",
  "description": "Material 3 color roles and scales on Liquid-Glass-style translucent surfaces. Tokens, CSS components, refraction and liquid motion. No dependencies.",
  "homepage": "https://github.com/sky-five/material-glass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sky-five/material-glass.git"
  },
  "license": "MIT",
  "type": "module",
  "style": "material-glass.css",
  "main": "material-glass.js",
  "files": [
    "material-glass.css",
    "material-glass.js",
    "tokens/"
  ],
  "keywords": [
    "design-system",
    "design-tokens",
    "material-design",
    "material-3",
    "glassmorphism",
    "liquid-glass",
    "css",
    "theme"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/pages.mjs",
    "test": "node scripts/lint-css.mjs && node scripts/contrast.mjs",
    "themes": "node scripts/theme.mjs",
    "test:contrast": "node scripts/contrast.mjs",
    "test:css": "node scripts/lint-css.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "lightningcss": "^1.28.2"
  }
}
