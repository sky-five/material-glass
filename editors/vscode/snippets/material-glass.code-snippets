{
  "Material Glass: page setup": {
    "prefix": "mg-page",
    "body": [
      "<!doctype html>",
      "<html lang=\"en\" data-mg-theme=\"${1|sea-glass,prism,obsidian,frost,ember,aurora,mono,sand|}\" data-mg-mode=\"${2|dark,light|}\">",
      "<head>",
      "<meta charset=\"utf-8\">",
      "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/sky-five/material-glass@main/material-glass.min.css\">",
      "<script defer src=\"https://cdn.jsdelivr.net/gh/sky-five/material-glass@main/material-glass.min.js\"></script>",
      "</head>",
      "<body class=\"mg-scene\">",
      "\t$0",
      "</body>",
      "</html>"
    ]
  },
  "Material Glass: button": { "prefix": "mg-btn", "body": "<button class=\"mg-btn${1| , mg-btn--tonal, mg-btn--glass, mg-btn--outlined, mg-btn--text, mg-btn--danger|}\" type=\"button\">${2:Label}</button>" },
  "Material Glass: icon button": { "prefix": "mg-icon-btn", "body": "<button class=\"mg-icon-btn\" type=\"button\" aria-label=\"${1:Label}\">${2:<svg aria-hidden=\"true\"></svg>}</button>" },
  "Material Glass: FAB": { "prefix": "mg-fab", "body": "<button class=\"mg-fab\" type=\"button\" aria-label=\"${1:Create}\">${2:<svg aria-hidden=\"true\"></svg>}</button>" },
  "Material Glass: card": {
    "prefix": "mg-card",
    "body": [
      "<div class=\"mg-card mg-glass-${1|2,0,1,3,4|}\">",
      "\t<h3 class=\"mg-card__title\">${2:Title}</h3>",
      "\t<p class=\"mg-card__body\">${3:Body}</p>",
      "\t<div class=\"mg-card__actions\"><button class=\"mg-btn\" type=\"button\">${4:Action}</button></div>",
      "</div>"
    ]
  },
  "Material Glass: glass surface": { "prefix": "mg-glass", "body": "<div class=\"mg-glass-${1|2,0,1,3,4|}\"${2: data-mg-refract=\"24\"}>$0</div>" },
  "Material Glass: text field": {
    "prefix": "mg-field",
    "body": "<label class=\"mg-field${1| , mg-field--outlined, mg-field--filled|}\"><span class=\"mg-field__label\">${2:Label}</span><input class=\"mg-field__input\" type=\"${3:text}\" name=\"${4}\"></label>"
  },
  "Material Glass: switch": { "prefix": "mg-switch", "body": "<button class=\"mg-switch\" type=\"button\" role=\"switch\" aria-checked=\"${1|false,true|}\" aria-label=\"${2:Label}\"></button>" },
  "Material Glass: slider": { "prefix": "mg-slider", "body": "<input class=\"mg-slider\" type=\"range\" min=\"0\" max=\"100\" value=\"${1:50}\" aria-label=\"${2:Label}\">" },
  "Material Glass: chip": { "prefix": "mg-chip", "body": "<button class=\"mg-chip\" type=\"button\" aria-pressed=\"${1|false,true|}\">${2:Label}</button>" },
  "Material Glass: navigation bar": {
    "prefix": "mg-nav",
    "body": [
      "<nav class=\"mg-nav mg-glass-3\" data-mg-liquid aria-label=\"${1:Main}\">",
      "\t<a class=\"mg-nav__item\" href=\"${2:/}\" aria-current=\"page\">${3:Home}</a>",
      "\t<a class=\"mg-nav__item\" href=\"${4:/search}\">${5:Search}</a>",
      "</nav>"
    ]
  },
  "Material Glass: segmented": {
    "prefix": "mg-segmented",
    "body": [
      "<div class=\"mg-segmented mg-glass-1\" data-mg-liquid role=\"group\" aria-label=\"${1:View}\">",
      "\t<button class=\"mg-segmented__item\" type=\"button\" aria-pressed=\"true\">${2:Day}</button>",
      "\t<button class=\"mg-segmented__item\" type=\"button\" aria-pressed=\"false\">${3:Week}</button>",
      "</div>"
    ]
  },
  "Material Glass: tabs": {
    "prefix": "mg-tabs",
    "body": [
      "<div class=\"mg-tabs\" role=\"tablist\" data-mg-liquid aria-label=\"${1:Sections}\">",
      "\t<button class=\"mg-tab\" type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"${2:panel-1}\">${3:One}</button>",
      "\t<button class=\"mg-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"${4:panel-2}\">${5:Two}</button>",
      "</div>",
      "<div class=\"mg-tab-panel\" role=\"tabpanel\" id=\"${2}\">$0</div>",
      "<div class=\"mg-tab-panel\" role=\"tabpanel\" id=\"${4}\" hidden></div>"
    ]
  },
  "Material Glass: top app bar": {
    "prefix": "mg-top-bar",
    "body": [
      "<header class=\"mg-top-bar mg-glass-1\" data-mg-top-bar>",
      "\t<div class=\"mg-top-bar__lead\">$1</div>",
      "\t<h1 class=\"mg-top-bar__title\">${2:Title}</h1>",
      "\t<div class=\"mg-top-bar__trail\">$3</div>",
      "</header>"
    ]
  },
  "Material Glass: dialog": {
    "prefix": "mg-dialog",
    "body": [
      "<dialog class=\"mg-dialog mg-glass-3\" id=\"${1:dialog}\" aria-labelledby=\"${1}-title\">",
      "\t<h2 class=\"mg-dialog__title\" id=\"${1}-title\">${2:Title}</h2>",
      "\t<p class=\"mg-dialog__body\">${3:Body}</p>",
      "\t<form method=\"dialog\" class=\"mg-dialog__actions\"><button class=\"mg-btn mg-btn--text\" value=\"cancel\">Cancel</button><button class=\"mg-btn\" value=\"ok\">${4:OK}</button></form>",
      "</dialog>"
    ]
  },
  "Material Glass: bottom sheet": {
    "prefix": "mg-sheet",
    "body": [
      "<dialog class=\"mg-sheet mg-glass-3\" id=\"${1:sheet}\" aria-labelledby=\"${1}-title\">",
      "\t<div class=\"mg-sheet__handle\" aria-hidden=\"true\"></div>",
      "\t<h2 class=\"mg-sheet__title\" id=\"${1}-title\">${2:Title}</h2>",
      "\t$0",
      "</dialog>"
    ]
  },
  "Material Glass: menu": {
    "prefix": "mg-menu",
    "body": [
      "<button class=\"mg-btn mg-btn--glass\" type=\"button\" popovertarget=\"${1:menu}\">${2:Open}</button>",
      "<div class=\"mg-menu mg-glass-3\" id=\"${1}\" popover role=\"menu\">",
      "\t<button class=\"mg-menu__item\" type=\"button\" role=\"menuitem\">${3:Item}</button>",
      "</div>"
    ]
  },
  "Material Glass: date picker": { "prefix": "mg-datepicker", "body": "<div class=\"mg-datepicker mg-glass-2\" data-mg-datepicker data-value=\"${1:2026-11-02}\" aria-label=\"${2:Choose date}\"></div>" },
  "Material Glass: progress": { "prefix": "mg-progress", "body": "<progress class=\"mg-progress\" value=\"${1:40}\" max=\"100\" aria-label=\"${2:Progress}\"></progress>" },
  "Material Glass: data table": {
    "prefix": "mg-table",
    "body": [
      "<div class=\"mg-table-wrap\">",
      "\t<table class=\"mg-table\" data-mg-sortable>",
      "\t\t<thead><tr><th scope=\"col\">${1:Name}</th><th scope=\"col\" class=\"mg-table__num\">${2:Value}</th></tr></thead>",
      "\t\t<tbody><tr><td>$3</td><td class=\"mg-table__num\">$4</td></tr></tbody>",
      "\t</table>",
      "</div>"
    ]
  },
  "Material Glass: toast": { "prefix": "mg-toast", "body": "MaterialGlass.toast('${1:Saved}'${2:, { action: 'Undo', onAction() {} \\}});" }
}
