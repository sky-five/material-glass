    "duration-short": 160,
    "duration-medium": 320,
    "duration-long": 520,
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-emphasized": "cubic-bezier(0.3, 0, 0, 1.15)"
