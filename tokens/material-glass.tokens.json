    "shadow-y": [4, 6, 8, 11, 14],
    "shadow-blur": [16, 22, 28, 44, 56]
  },
  "shape": { "none": 0, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "full": 9999 },
  "state": { "hover": 0.08, "focus": 0.12, "pressed": 0.12, "dragged": 0.16 },
